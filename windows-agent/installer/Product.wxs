<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Hospital Diagnostic Components" Manufacturer="Hospital Diagnostic Dashboard"
           Version="$(var.ProductVersion)" UpgradeCode="{C9B68B38-09CE-4AC5-BF3D-1E18BE4B82F0}"
           Scope="perMachine" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="Hospital diagnostic connector, collector, and local notification components" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version is already installed." />
    <Property Id="REMOVE_CONFIGURATION" Value="0" Secure="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Use the Start menu Configure shortcut to enroll this PC and configure each component." />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hospital Diagnostic Components" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Hospital Diagnostic Components" />
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ConnectorFiles" Guid="{BF34FCB3-919E-4C31-8A6E-22FCD8C38AC6}" Bitness="always64">
        <File Id="RemoteAgentExe" Source="$(var.PayloadDir)\hospital-remote-agent.exe" KeyPath="yes" />
        <File Id="InstallAgentScript" Source="$(var.PayloadDir)\Install-Agent.ps1" />
        <File Id="UninstallAgentScript" Source="$(var.PayloadDir)\Uninstall-Agent.ps1" />
        <File Id="PreflightScript" Source="$(var.PayloadDir)\Preflight.ps1" />
        <ServiceControl Id="StopConnectorForMaintenance" Name="HospitalRemoteAgent" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="CollectorFiles" Guid="{95AA4494-E6A0-47EC-96CE-CE4AF2DEFC6D}" Bitness="always64">
        <File Id="CollectorExe" Source="$(var.PayloadDir)\hospital-collector.exe" KeyPath="yes" />
        <File Id="InstallCollectorTaskScript" Source="$(var.PayloadDir)\install-collector-task.ps1" />
      </Component>
      <Component Id="NotificationFiles" Guid="{2CB7FD55-69F7-4CC4-A8C1-8B4405BF9FF0}" Bitness="always64">
        <File Id="NotificationUiScript" Source="$(var.PayloadDir)\HospitalRemoteUI.ps1" KeyPath="yes" />
        <File Id="RegisterNotificationScript" Source="$(var.PayloadDir)\Register-NotificationUI.ps1" />
      </Component>
      <Component Id="MaintenanceFiles" Guid="{0D7EC451-24CF-492B-88B2-F0621AD45EC5}" Bitness="always64">
        <File Id="ConfigureInstallationScript" Source="$(var.PayloadDir)\Configure-Installation.ps1" />
        <File Id="RemoveInstallationScript" Source="$(var.PayloadDir)\Remove-Installation.ps1" />
        <File Id="InstallerLauncherExe" Source="$(var.PayloadDir)\hospital-installer-launcher.exe" KeyPath="yes">
          <Shortcut Id="ConfigureShortcut" Directory="ProgramMenuDir" Name="Configure diagnostic components" Advertise="yes"
                    Arguments="configure" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="UninstallShortcut" Directory="ProgramMenuDir" Name="Uninstall diagnostic components" Advertise="yes"
                    Arguments="uninstall [ProductCode]" WorkingDirectory="INSTALLFOLDER" />
        </File>
        <RemoveFolder Id="RemoveProgramMenuDirectory" Directory="ProgramMenuDir" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="ConnectorFeature" Title="Remote Connector" Level="1" AllowAbsent="no">
      <ComponentRef Id="ConnectorFiles" />
      <ComponentRef Id="MaintenanceFiles" />
    </Feature>
    <Feature Id="CollectorFeature" Title="Data Collector" Level="1">
      <ComponentRef Id="CollectorFiles" />
    </Feature>
    <Feature Id="NotificationFeature" Title="Local Notification and End Session" Level="1">
      <ComponentRef Id="NotificationFiles" />
    </Feature>

    <SetProperty Id="CleanupInstalledComponents"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy AllSigned -File &quot;[INSTALLFOLDER]Remove-Installation.ps1&quot; -RemoveConfiguration &quot;[REMOVE_CONFIGURATION]&quot;"
                 Before="CleanupInstalledComponents" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="CleanupInstalledComponents" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <SetProperty Id="RepairConfiguredConnector"
                 Value="&quot;[#RemoteAgentExe]&quot; repair-service-if-configured &quot;[CommonAppDataFolder]HospitalRemoteAgent\service.dat&quot;"
                 Before="RepairConfiguredConnector" Sequence="execute"
                 Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="RepairConfiguredConnector" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <SetProperty Id="RemoveCollectorTask"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy AllSigned -File &quot;[INSTALLFOLDER]Remove-Installation.ps1&quot; -Component Collector"
                 Before="RemoveCollectorTask" Sequence="execute"
                 Condition="REMOVE&lt;&gt;&quot;ALL&quot; AND (&amp;CollectorFeature=2) AND (!CollectorFeature=3) AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="RemoveCollectorTask" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <SetProperty Id="RemoveNotificationTask"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy AllSigned -File &quot;[INSTALLFOLDER]Remove-Installation.ps1&quot; -Component Notification"
                 Before="RemoveNotificationTask" Sequence="execute"
                 Condition="REMOVE&lt;&gt;&quot;ALL&quot; AND (&amp;NotificationFeature=2) AND (!NotificationFeature=3) AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="RemoveNotificationTask" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="RepairConfiguredConnector" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CleanupInstalledComponents" Before="DeleteServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveCollectorTask" Before="InstallFinalize" Condition="REMOVE&lt;&gt;&quot;ALL&quot; AND (&amp;CollectorFeature=2) AND (!CollectorFeature=3) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveNotificationTask" Before="InstallFinalize" Condition="REMOVE&lt;&gt;&quot;ALL&quot; AND (&amp;NotificationFeature=2) AND (!NotificationFeature=3) AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
