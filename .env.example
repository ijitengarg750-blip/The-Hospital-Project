POSTGRES_DB=hospital_dashboard
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql+psycopg://hospital_app:replace-with-a-long-database-password@db:5432/hospital_dashboard
STORAGE_ROOT=/clinical-data
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=replace-with-a-long-doctor-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-different-long-administrator-password
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480
SESSION_COOKIE_SECURE=true
MFA_REQUIRED=false
MAX_UPLOAD_BYTES=2000000000
ALLOWED_ORIGINS=http://localhost,http://localhost:8080
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15
# Absolute paths inside the backend container. docker-compose.remote-access.yml mounts these files read-only.
VNC_GATEWAY_CA_CERT_FILE=/run/mtls/gateway-ca.crt
VNC_GATEWAY_CLIENT_CERT_FILE=/run/mtls/gateway-client.crt
VNC_GATEWAY_CLIENT_KEY_FILE=/run/mtls/gateway-client.key

